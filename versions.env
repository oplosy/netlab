# ENV-010 environment lock. Keep versions explicit; do not replace with a
# moving channel (latest, stable, edge, or an unqualified major version).
# Source: repository environment policy, reviewed with ENV-010.

ENV_POLICY_VERSION=1

# The lab runs in a dedicated WSL2 distribution (ADR-0001).
WSL_KERNEL_MIN_VERSION=5.15.0

# Docker Engine and Containerlab versions used by the baseline toolchain.
# The preflight requires these exact versions so a host cannot silently drift.
DOCKER_ENGINE_VERSION=29.6.2
DOCKER_CLI_VERSION=29.6.2
CONTAINERLAB_VERSION=0.77.0
UV_VERSION=0.12.0

# Minimum resources for the Phase 1 topology and evidence services.
MIN_CPU_COUNT=4
MIN_MEMORY_GIB=8
MIN_DISK_GIB=40

# Kernel capability policy. The preflight checks these without loading modules.
REQUIRED_KERNEL_FEATURES="
CONFIG_NET_NS
CONFIG_VETH
CONFIG_BRIDGE
CONFIG_BRIDGE_VLAN_FILTERING
CONFIG_VLAN_8021Q
CONFIG_NETFILTER
CONFIG_NF_TABLES
CONFIG_XFRM_INTERFACE
CONFIG_XFRM_USER
CONFIG_OPENVSWITCH
"

# IMG-020 image lock. The Ubuntu manifest digest is the linux/amd64 manifest
# for the noble-20260905 build; the tag is retained for human identification.
IMAGE_PLATFORM=linux/amd64
UBUNTU_BASE_IMAGE=ubuntu:24.04@sha256:a61567bd31828687156d735ea8eb01ba4e37636e225dd6a48ba94136a70d9d61
UBUNTU_BASE_DIGEST=sha256:a61567bd31828687156d735ea8eb01ba4e37636e225dd6a48ba94136a70d9d61
UBUNTU_SNAPSHOT=20260905T000000Z

# Exact amd64 Noble package versions available from the immutable snapshot.
# Do not replace these with an upstream release label without also changing
# the package source and checksum policy.
FRR_VERSION=8.4.4-1.1ubuntu6.7
OVS_VERSION=3.3.9-0ubuntu0.24.04.1
KEEPALIVED_VERSION=1:2.2.8-1build2
STRONGSWAN_VERSION=5.9.13-2ubuntu4.24.04.4
NFTABLES_VERSION=1.0.9-1ubuntu0.1
KEA_VERSION=2.4.1-3ubuntu0.2
BIND9_VERSION=1:9.18.39-0ubuntu0.24.04.7
BIND9_DNSUTILS_VERSION=1:9.18.39-0ubuntu0.24.04.7
BIND9_UTILS_VERSION=1:9.18.39-0ubuntu0.24.04.7
CHRONY_VERSION=4.5-1ubuntu4.2
FREERADIUS_VERSION=3.2.5+dfsg-3~ubuntu24.04.3
ISC_DHCP_RELAY_VERSION=4.4.3-P1-4ubuntu2
DHCP_CLIENT_VERSION=4.4.3-P1-4ubuntu2
OPENSSH_SERVER_VERSION=1:9.6p1-3ubuntu13.19
LIBPAM_RADIUS_AUTH_VERSION=2.0.1-1
OPENSSH_CLIENT_VERSION=1:9.6p1-3ubuntu13.19
SSHPASS_VERSION=1.09-1

# OBS-180 observability stack. Images are linux/amd64 manifest-list digests.
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0@sha256:5ce7540c3c00ef4ab0c9d2c995c6a5b9c421f44b4a115d97a2c7af3b1c21cbb0
SNMP_EXPORTER_IMAGE=prom/snmp-exporter:v0.30.1@sha256:e5fd5e8b43ace6c088fe9bf0b37b7fff0e04380bee352be7ec41b853a4dd5859
GRAFANA_IMAGE=grafana/grafana:13.2.2@sha256:ac461fb352abc50da10a51c7d02462e9c05488f11f53f14b3ad79a8145f638a0
SYSLOG_NG_IMAGE=balabit/syslog-ng:4.11.0@sha256:c652345a143843731037863abc6bfd75da5ddaf618a94ca42147fa2d59fbcf89
ALLOY_IMAGE=grafana/alloy:v1.19.2@sha256:b8ec653c44235fbe910879145dac3597d66b0aaecf60bcbbe82580767771a839
LOKI_IMAGE=grafana/loki:3.7.8@sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193
