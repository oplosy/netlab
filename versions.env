# AUTO-510 NetBox projection (ADR 0019). linux/amd64 manifest-list digests.
NETBOX_IMAGE=netboxcommunity/netbox:v4.4.10-3.4.2@sha256:14c2de3f179d8ed5b5722a76b6d7389c8c95bb8be46c600f3d7fe1f7698b4574
NETBOX_POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
NETBOX_VALKEY_IMAGE=valkey/valkey:8.1.4-alpine@sha256:e706d1213aaba6896c162bb6a3a9e1894e1a435f28f8f856d14fab2e10aa098b

# EDGE-420 inline IPS (ADR 0018); bumps the network-node image to 0.2.0.
SURICATA_VERSION=1:7.0.3-1build3
NETLAB_NETWORK_IMAGE=netlab/network-node:0.2.0
NETLAB_CLIENT_IMAGE=netlab/client:0.1.0
NETLAB_SERVICE_IMAGE=netlab/service:0.1.0
